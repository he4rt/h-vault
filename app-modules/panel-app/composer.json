{
    "name": "he4rt/panel-app",
    "description": "Filament user panel for file, bucket, and album management",
    "type": "library",
    "version": "1.0.0",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "He4rt\\PanelApp\\": "src/",
            "He4rt\\PanelApp\\Database\\Factories\\": "database/factories/",
            "He4rt\\PanelApp\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "He4rt\\PanelApp\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "He4rt\\PanelApp\\PanelAppServiceProvider"
            ]
        }
    }
}
