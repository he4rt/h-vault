{
    "name": "@he4rt/sycorax",
    "license": "MIT",
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^24"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "npx prettier --write \"**/*.{js,ts,json,yml,md,css}\"",
        "prepare": "husky",
        "outdated": "npm-check-updates"
    },
    "devDependencies": {
        "@emnapi/core": "1.10.0",
        "@emnapi/runtime": "1.10.0",
        "@tailwindcss/typography": "0.5.19",
        "@tailwindcss/vite": "4.3.0",
        "autoprefixer": "10.5.0",
        "concurrently": "9.2.1",
        "husky": "9.1.7",
        "laravel-vite-plugin": "3.1.0",
        "lint-staged": "17.0.5",
        "npm-check-updates": "22.2.0",
        "prettier": "3.8.3",
        "tailwindcss": "4.3.0",
        "vite": "8.0.13"
    },
    "lint-staged": {
        "*.{js,ts,json,yml,md,css,blade.php}": [
            "prettier --write"
        ],
        "*.php": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ]
    }
}
